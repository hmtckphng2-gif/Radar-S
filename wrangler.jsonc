{
  "name": "suedtirol-radar-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": []
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_JOURNEY_LIMITER",
      "namespace_id": "20261108",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "ASSISTANT_ENABLED": "true",
    "GROQ_FREE_TIER_ONLY": "true",
    "CLOUDFLARE_AI_FREE_TIER_ONLY": "true"
  }
}
