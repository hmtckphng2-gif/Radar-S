{
  "name": "suedtirol-radar-2",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "triggers": {"crons": ["*/5 * * * *"]},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "AI_JOURNEY_LIMITER",
      "namespace_id": "7031",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
