{
  "name": "suedtirol-radar-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": []
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_JOURNEY_LIMITER",
      "namespace_id": "910001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
